menu "Example Configuration"

    config CORRECT_WIFI_SSID
        string "WiFi SSID"
        default "listenai_wifi_test"

    config CORRECT_WIFI_PASSWORD
        string "WiFi password"
        default "wifitest"

    config WRONG_WIFI_SSID
        string "WiFi SSID"
        default "not_exist"

    config WRONG_WIFI_PASSWORD
        string "WiFi password"
        default "111111111"
endmenu

source "Kconfig.zephyr"
