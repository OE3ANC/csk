/dts-v1/;
#include <csk/csk6001.dtsi>
#include <dt-bindings/pwm/pwm.h>

/ {
     model = "csk6001 devkit";
     compatible = "csk,csk6001devkit";
     aliases {
		led0 = &green_led;
                sw0 = &user_button_0;
                pwm-led0 = &green_pwm_led;
	};

        chosen {
                zephyr,console = &uart0;
                zephyr,shell-uart = &uart0;
                zephyr,sram = &sram0;
                zephyr,flash = &flash0;
                /* other chosen settings  for your hardware */
        };

        leds {
                compatible = "gpio-leds";
                green_led: led_1 {
                        gpios = <&gpio0 16 0>;
                        label = "User LED_GREEN";
                };
        };

        pwmleds {
		compatible = "pwm-leds";
		green_pwm_led: green_pwm_led {
			pwms = <&pwm0 0 PWM_POLARITY_NORMAL>;
			label = "User LED_GREEN - PWM0";
		};

	};

        gpio_keys {
		compatible = "gpio-keys";
		user_button_0: button_0 {
			label = "User SW0";
			gpios = <&gpio1 6 0>;
		};
	};

     /*
      * Your board-specific hardware: buttons, LEDs, sensors, etc.
      */
};

&gpt0 {
	status = "okay";

	pwm0: pwm0 {
                pinmuxs = <&pinmux0 16 11>;
                clock-prescaler = <128>;
                status = "okay";
	};

};


&gpio0 {
        status = "okay";
};

&gpio1 {
        status = "okay";
};

&uart0 {
	current-speed = <115200>;
	pinmuxs = <&pinmux0 2 2>, <&pinmux0 3 2>;
	pinmux-names = "RXD", "TXD";
	status = "okay";
};

&uart1 {
        status = "disabled";
};

&uart2 {
        status = "disabled";
};

&spi0 {
    miso-gpios = <&gpio0 17 0>;
    mosi-gpios = <&gpio0 18 0>;
    sclk-gpios = <&gpio0 19 0>;
    cs-gpios = <&gpio0 20 0>;
    status = "okay";
};

&spi1 {
    status = "disabled";
};

&green_led {
	status = "okay";
};

&mailbox0 {
	status = "okay";
};
