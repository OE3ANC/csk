# SPDX-License-Identifier: Apache-2.0

config SOC_CSK6
	bool "SOC_CSK6"
	select ARM
	select CPU_CORTEX_M33
	select CPU_CORTEX_M_HAS_DWT
	select CPU_HAS_ARM_SAU
	select CPU_HAS_FPU
	select CPU_HAS_MPU
	select CPU_HAS_ARM_MPU
	select ARMV8_M_DSP
	select CPU_CORTEX_M_HAS_SYSTICK
	select HAS_CSK6
	select CPU_HAS_CUSTOM_FIXED_SOC_MPU_REGIONS
	select ARCH_HAS_NOCACHE_MEMORY_SUPPORT
	select BUILD_OUTPUT_HEX
	select PLATFORM_SPECIFIC_INIT
	select PINCTRL
	select CPU_HAS_DCACHE
	select CPU_HAS_ICACHE

config HAS_CSK6
	bool
	select HAS_CMSIS_CORE
	depends on SOC_CSK6


if SOC_CSK6
	config CSK6_ICACHE
		bool "Enable CSK6 ICACHE"
		default y
		help
			Enable CSK6 ICACHE
	config CSK6_DCACHE
		bool "Enable CSK6 DCACHE"
		default y
		help
			Enable CSK6 DCACHE
	config CSK6_PSRAM
		bool "Enable CSK6 PSRAM"
		default y
		help
			Enable CSK6 PSRAM

config CSK6_FATAL
	bool "Enable csk6 fatal"
	default y
	help
		Enable csk6 fatal

config CSK6_FATAL_BACKTRACE
	bool "Enable csk6 backtrace print after fatal"
	default y
	select EXTRA_EXCEPTION_INFO
	help
		Enable csk6 fatal

config CSK6_FATAL_UNHANDLE_INTERRUPT
	bool "Enable csk6 unhandle interrupt print"
	default y
	help
		Enable csk6 unhandle interrupt print

endif # SOC_CSK6
