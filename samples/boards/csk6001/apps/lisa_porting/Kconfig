menu "Example Configuration"

    config EXAMPLE_WIFI_SSID
        string "WiFi SSID"
        default "TP-LINK_BA83"
        #default "TP-LINK_LINGSI"

    config EXAMPLE_WIFI_PASSWORD
        string "WiFi password"
        default "ab123456"
        #default "a123456789"

endmenu

DT_CHOSEN_Z_LISA_HEAP := zephyr,lisa_heap

config LISA_HEAP_BASE_ADDRESS
	hex
	default "$(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_LISA_HEAP))"
	help
	  This option specifies base address of the memory region to
	  be used for the lisa heap memory

config LISA_HEAP_SIZE
	hex
	default "$(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_LISA_HEAP))"
	help
	  This option specifies size of the memory region to be used
	  for the lisa heap memory



source "Kconfig.zephyr"
