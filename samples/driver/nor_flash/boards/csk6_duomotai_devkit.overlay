/delete-node/ &storage_partition;
/ {

};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
		filesystem_part: partition@100000 {
			reg = <0x100000 0x200000>;
		};
		/*
		 * Reserve the final 640 KiB for file system partition
		 */
		storage_partition: partition@600000 {
			reg = <0x600000 0x600000>;
		};
	};
};
