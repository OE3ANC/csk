/{
    aliases {
        gpioa1 = &gpioa1;
    };

    gpio,user {
        compatible = "listenai,csk-gpio-user";
        gpioa1: gpioa1 {
            gpios = <&gpioa 0x1 0x0>;
            label = "gpioa_1";
        };
    };
};
