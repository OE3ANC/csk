menuconfig WIFI_MANAGER
	bool "ESP-Hosted support"
	select NVS
	select FLASH
	select FLASH_PAGE_LAYOUT
	select FLASH_MAP
	select MPU_ALLOW_FLASH_WRITE


if WIFI_MANAGER
	module = WIFI_MANAGER
	module-str = wifi_manager
	source "subsys/logging/Kconfig.template.log_config"
endif
