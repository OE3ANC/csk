menuconfig ESP_HOSTED
	bool "ESP-Hosted support"
	select PROTOBUF_C

if ESP_HOSTED

module = ESP_HOSTED
module-str = esp-hosted
source "subsys/logging/Kconfig.template.log_config"

config HOSTED_INIT_TIMEOUT
	int "Hosted Init Timeout(s)"
	default 3

config HOSTED_TRANSACTION_STACK
	int "Hosted Transaction Thread Stack"
	default 2048

config HOSTED_TRANSACTION_PRIORITY
	int "Hosted Transaction Thread priority"
	default -1

config HOSTED_PROCESS_RX_STACK
	int "Hosted Processing Thread Stack"
	default 2048

config HOSTED_PROCESS_RX_PRIORITY
	int "Hosted Processing Thread priority"
	default -1

config HOSTED_TX_QUEUE_LEN
	int "Hosted TX Queue Len"
	default 30

config HOSTED_RX_QUEUE_LEN
	int "Hosted RX Queue Len"
	default 30

config HOSTED_SERIALIF_QUEUE_LEN
	int "Hosted Serial if queue len"
	default 50

config HOSTED_NETIF_QUEUE_LEN
	int "Hosted Net if queue len"
	default 50

config HOSTED_RAW_THROUGHPUT_TEST_ENABLE
	bool "Esp-Hosted Raw throughput testing enable"
	default false

if HOSTED_RAW_THROUGHPUT_TEST_ENABLE

config HOSTED_RAW_THROUGHPUT_TEST_ESP_TO_HOST
	bool "test ESP -> host raw throughput"
	default true
	help
	  if true, test ESP -> host raw throughput
	  else, test Host -> ESP raw throughput

config HOSTED_RAW_THROUGHPUT_TEST_HOST_TO_ESP_STACK
	int "Host to ESP raw throughput test thread stack"
	default 4096

config HOSTED_RAW_THROUGHPUT_TEST_HOST_TO_ESP_PRIORITY
	int "Host to ESP raw throughput test thread prority"
	default -1

endif # HOSTED_RAW_THROUGHPUT_TEST_ENABLE

endif # ESP_HOSTED
