config SC7A20H
	bool "SC7A20H Three-Axis Accelerometer"
	default y
	depends on DT_HAS_LISTENAI_SC7A20H_ENABLED
	select I2C
	help
	  Enable driver for SC7A20H I2C-based three-axis accelerometer.

if SC7A20H

config SC7A20H_TRIGGER
	bool "Enable trigger support"
	depends on GPIO
	help
	  Enable trigger support (interrupts) for SC7A20H accelerometer.

choice
	prompt "触发模式选择"
	default SC7A20H_TRIGGER_THREAD
	depends on SC7A20H_TRIGGER

config SC7A20H_TRIGGER_THREAD
	bool "线程模式"
	help
		使用独立线程处理传感器触发事件

config SC7A20H_TRIGGER_GLOBAL_THREAD
	bool "全局线程模式"
	help
		使用系统全局线程处理触发事件

endchoice

config SC7A20H_THREAD_PRIORITY
	int "Thread priority"
	default 10
	depends on SC7A20H_TRIGGER_THREAD
	range 0 255
	help
	  Priority of thread used by the driver to handle interrupts.

config SC7A20H_THREAD_STACK_SIZE
	int "Thread stack size"
	default 1024
	depends on SC7A20H_TRIGGER_THREAD
	range 512 4096
	help
	  Stack size of thread used by the driver to handle interrupts.

config SC7A20H_ACCEL_FS
	int "Accelerometer full-scale range"
	default 2
	help
	  Accelerometer full-scale range.
	  An X value for the config represents a range of +/- X g.
	  Valid values are 2, 4, 8 and 16.

endif # SC7A20H
