# SPDX-License-Identifier: Apache-2.0

menuconfig SPI_CSK6001
	bool "CSK6001 SPI driver"
	default y
	depends on HAS_CSK6001
	help
	  Enable the csk6001 SPI driver.

if SPI_CSK6001

config SPI_CTRL_STACK_SIZE
	int "Control Task Stack Size"
	default 1024

config SPI_CTRL_PRIORITY
	int "Control Task Priority"
	default 5

config SPI_TX_DMA
	bool "Enable SPI TX DMA"
	default y
	select DMA

config SPI_RX_DMA
	bool "Enable SPI RX DMA"
	default y
	select DMA

endif #SPI_CSK6001
