config PWM_CSK6
	bool "CSK6 PWM driver"
	depends on HAS_CSK6
	select HAS_CSK6_GPT
	select COUNTER
	select COUNTER_CSK6
	default y
	help
	  This option enables the PWM driver for CSK6. Say y if you wish to use PWM port on CSK6.

config PWM_CSK6_INIT_PRIORITY
	int "pwm csk6 init priority"
	default 51
	help
		pwm csk6 init priority
		must more than counter driver priority