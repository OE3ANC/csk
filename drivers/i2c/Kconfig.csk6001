config I2C_CSK6001
	bool "listenai CSK6001 embedded controller (EC) I2C driver"
	default y
	depends on HAS_CSK6001
	help
	  This option enables the I2C driver for CSK6001.
	  Say y if you wish to use I2C modules on CSK6001.
	  
