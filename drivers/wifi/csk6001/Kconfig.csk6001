menuconfig WIFI_CSK6001
	bool "CSK6001 WiFi Driver"
	default y
	depends on HAS_CSK6001
	select PROTOBUF_C
	select ESP_HOSTED
	help
	  Enable CSK6001 SoC WiFi

if WIFI_CSK6001

config CSK_WIFI_STATION
	bool "WiFi Station Enable"

config CSK_WIFI_SOFTAP
	bool "WiFi SoftAP Enable"

config WIFI_CTRL_STACK_SIZE
	int "Control Task Stack Size"
	default 8192

config WIFI_CTRL_PRIORITY
	int "Control Task Priority"
	default 4

endif #WIFI_CSK6001
