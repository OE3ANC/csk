#include <arm/armv8-m.dtsi>

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-m33";
			reg = <0>;
		};
	};

	flash0: flash@18000000 {
		reg = <0x18000000 (8000*1024)>;
	};

	sram0: memory@80000 {
		compatible = "mmio-sram";
		reg = <0x00080000 (320*1024)>;
	};

	soc {
		uart0: uart@45000000 {
			compatible = "listenai,csk-uart";
			reg = <0x45000000 0x100000>;
			interrupts = <8 2>;
			label = "UART_0";
		};

		uart1: uart@45100000 {
			compatible = "listenai,csk-uart";
			reg = <0x45100000 0x100000>;
			interrupts = <9 2>;
			label = "UART_1";
		};

		uart2: uart@45200000 {
			compatible = "listenai,csk-uart";
			reg = <0x45200000 0x100000>;
			interrupts = <10 2>;
			label = "UART_2";
		};

		pinmux: pinmux@46200000 {
			compatible = "listenai,csk-pinmux";
			reg = <0x46200000 0x100000>;
			label = "PINMUX";
			#pinmux-cells = <2>;
		};

		gpio0: gpio@45900000 {
			compatible = "listenai,csk-gpio";
			reg = <0x45900000 0x100000>;
			interrupts = <17 2>;
			label = "GPIO_A";
			gpio-controller;
			#gpio-cells = <2>;
		};

		gpio1: gpio@45a00000 {
			compatible = "listenai,csk-gpio";
			reg = <0x45a00000 0x100000>;
			interrupts = <18 2>;
			label = "GPIO_B";
			gpio-controller;
			#gpio-cells = <2>;
		};
	};
};

&nvic {
	arm,num-irq-priority-bits = <3>;
};
