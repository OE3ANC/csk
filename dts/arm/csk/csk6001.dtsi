#include <mem.h>
#include <arm/armv8-m.dtsi>

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-m33";
			reg = <0>;
		};
	};

	sram0: memory@80000 {
		compatible = "mmio-sram";
		reg = <0x00080000 (320*1024)>;
	};

	soc {

		flash: flash-controller@46400000 {
			compatible = "listenai,csk-flash-controller";
			label = "FLASH_CTRL";
			reg = <0x46400000 DT_SIZE_M(1)>;
			#address-cells = <1>;
			#size-cells = <1>;


			flash0: flash@18000000 {
				compatible = "listenai,csk-nv-flash","soc-nv-flash";
				label = "FLASH_INN";
				reg = <0x18000000 DT_SIZE_M(8)>;
				write-block-size = <1>;
				erase-block-size = <4096>;
				/* maximum erase time for a 4K sector */
				max-erase-time = <100>;
			};

		};
		uart0: uart@45000000 {
			compatible = "listenai,csk-uart";
			reg = <0x45000000 0x4c>;
			label = "UART_0";
		};

		gpio0: gpio@45900000 {
			compatible = "listenai,csk-gpio";
			reg = <0x45900000 0x100000>;
			interrupts = <17 2>;
			label = "GPIO_A";
			gpio-controller;
			#gpio-cells = <2>;
		};

		gpio1: gpio@45A00000 {
			compatible = "listenai,csk-gpio";
			reg = <0x45A00000 0x100000>;
			interrupts = <18 2>;
			label = "GPIO_B";
			gpio-controller;
			#gpio-cells = <2>;
		};
	};
};

&nvic {
	arm,num-irq-priority-bits = <3>;
};
